# copy to .env and fill in — never commit .env to the repo

# where the mem0 REST API server is reachable
MEM0_URL=http://host.docker.internal:8000

# user_id namespace for all memories through this server
MEM0_USER_ID=default_user

# --- tuning knobs (all have working defaults, no rebuild needed to change) ---

# exact-content dedupe window: identical adds within this many seconds are
# skipped before they reach mem0 (saves an LLM extraction call per duplicate)
DEDUPE_WINDOW_SECONDS=604800

# writes hit mem0's extraction LLM; a cold model load on the backend can
# stall the request for minutes — this is how long the client waits it out
WRITE_TIMEOUT_SECONDS=300

# minimum seconds between mention-count bumps for the same memory (guards
# against a single conversation re-mentioning the same fact inflating counts)
MENTION_DEBOUNCE_SECONDS=21600

# reinforcement detection: a pre-add search finds the closest existing
# memory; if its score clears this (cheap, imprecise) pre-filter, the judge
# LLM below decides whether it's actually the same fact before bumping it.
# Similarity score alone isn't reliable enough to bump on directly — tested
# live, an unrelated fact scored higher than a genuine paraphrase of the
# real target. This is just here to skip obviously-unrelated candidates.
REINFORCEMENT_PREFILTER_THRESHOLD=0.75

# OpenAI-compatible endpoint used to judge candidate reinforcement matches.
# Leave JUDGE_LLM_BASE_URL unset to disable the judgment step entirely
# (reinforcement detection becomes a no-op rather than an unreliable guess).
JUDGE_LLM_BASE_URL=http://192.168.x.x:11434/v1
JUDGE_LLM_API_KEY=not-needed
JUDGE_LLM_MODEL=

# reranking: candidates fetched from mem0 before reranking / results returned after
SEARCH_OVERFETCH=50
SEARCH_TOP_K=10

# reranking: mention-boost weight and recency half-life (days)
MENTION_ALPHA=0.3
RECENCY_HALFLIFE_DAYS=30
